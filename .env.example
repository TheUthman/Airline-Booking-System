# Copy to .env for Docker Compose. Never commit the real values.
JWT_SECRET=replace-with-a-long-random-value
PAYMENT_WEBHOOK_SECRET=demo-payment-webhook-secret
REDIS_PASSWORD=replace-with-a-strong-redis-password
MAILGUN_API_KEY=key-replace-with-your-mailgun-api-key
MAILGUN_DOMAIN=sandbox-your-id.mailgun.org
MAILGUN_BASE_URL=https://api.mailgun.net
EMAIL_FROM="Airline Booking <postmaster@sandbox-your-id.mailgun.org>"

# Cost-based fare estimator defaults (illustrative; calibrate before real use)
FUEL_PRICE_PER_LITRE=950
ROUTE_DISTANCE_FACTOR=1.12
TAXI_AND_OVERHEAD_HOURS=0.50
CREW_COST_PER_FLIGHT=120000
EXPECTED_LOAD_FACTOR=0.75
TARGET_PROFIT_MARGIN=0.10
OTHER_REVENUE_PER_FLIGHT=0
BUSINESS_FARE_MULTIPLIER=3.0
